// ============================================
// Material, Supplier & Material Request Models
// ============================================

enum MaterialRequestStatus {
  PENDING
  APPROVED
  ORDERED
  DELIVERED
  CANCELLED
}

model Material {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  name         String
  unit         String
  unitPrice    Decimal  @default(0) @map("unit_price") @db.Decimal(12, 2)
  category     String?
  description  String?
  minimumStock Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 2)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests MaterialRequest[]

  @@index([companyId])
  @@map("materials")
}

model Supplier {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  name          String
  contactPerson String?  @map("contact_person")
  phone         String?
  email         String?
  address       String?
  materialTypes Json     @default("[]") @map("material_types")
  rating        Int?     @db.SmallInt
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  materialRequests MaterialRequest[]
  expenses         Expense[]
  purchases        Purchase[]

  @@index([companyId])
  @@map("suppliers")
}

model MaterialRequest {
  id            String                @id @default(cuid())
  projectId     String                @map("project_id")
  materialId    String                @map("material_id")
  supplierId    String?               @map("supplier_id")
  requestedById String                @map("requested_by_id")
  quantity      Decimal               @db.Decimal(12, 2)
  unitPrice     Decimal?              @map("unit_price") @db.Decimal(12, 2)
  totalPrice    Decimal?              @map("total_price") @db.Decimal(15, 2)
  status        MaterialRequestStatus @default(PENDING)
  deliveryDate  DateTime?             @map("delivery_date")
  notes         String?
  createdAt     DateTime              @default(now()) @map("created_at")
  updatedAt     DateTime              @updatedAt @map("updated_at")

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  material Material  @relation(fields: [materialId], references: [id])
  supplier Supplier? @relation(fields: [supplierId], references: [id])

  @@index([projectId])
  @@index([status])
  @@map("material_requests")
}
