// ============================================
// Expense Models
// ============================================

enum ExpenseCategory {
  LABOUR
  MATERIAL
  EQUIPMENT
  TRANSPORT
  SUBCONTRACTOR
  MISCELLANEOUS
}

enum ExpenseStatus {
  PENDING
  APPROVED
  REJECTED
  PAID
}

model Expense {
  id              String          @id @default(cuid())
  projectId       String          @map("project_id")
  submittedById   String          @map("submitted_by_id")
  approvedById    String?         @map("approved_by_id")
  category        ExpenseCategory
  title           String
  description     String?
  amount          Decimal         @db.Decimal(15, 2)
  currency        String          @default("LKR")
  receiptUrl      String?         @map("receipt_url")
  status          ExpenseStatus   @default(PENDING)
  approvedAt      DateTime?       @map("approved_at")
  rejectionReason String?         @map("rejection_reason")
  expenseDate     DateTime        @map("expense_date") @db.Date
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  department       String?
  supplierId       String? @map("supplier_id")
  budgetCategoryId String? @map("budget_category_id")
  fundingSourceId  String? @map("funding_source_id")
  projectWalletId  String? @map("project_wallet_id")
  paymentId        String? @map("payment_id")

  project     Project             @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submittedBy User                @relation(fields: [submittedById], references: [id])
  approvedBy  User?               @relation("ExpenseApprover", fields: [approvedById], references: [id])
  allocations FundingAllocation[]

  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  budgetCategory BudgetCategory? @relation(fields: [budgetCategoryId], references: [id])
  fundingSource  FundingSource?  @relation(fields: [fundingSourceId], references: [id])
  projectWallet  ProjectWallet?  @relation(fields: [projectWalletId], references: [id])
  payments       Payment[]

  @@index([projectId])
  @@index([status])
  @@index([category])
  @@index([supplierId])
  @@index([projectWalletId])
  @@map("expenses")
}
