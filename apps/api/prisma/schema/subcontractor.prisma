// ============================================
// Subcontractor & Contract Models
// ============================================

enum ContractStatus {
  DRAFT
  ACTIVE
  COMPLETED
  DISPUTED
  TERMINATED
}

model Subcontractor {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  name           String
  specialization String
  contactPerson  String?  @map("contact_person")
  phone          String?
  email          String?
  address        String?
  rating         Int?     @db.SmallInt
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company   Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contracts SubcontractorContract[]

  @@index([companyId])
  @@map("subcontractors")
}

model SubcontractorContract {
  id               String         @id @default(cuid())
  projectId        String         @map("project_id")
  subcontractorId  String         @map("subcontractor_id")
  workScope        String         @map("work_scope")
  contractAmount   Decimal        @map("contract_amount") @db.Decimal(15, 2)
  paidAmount       Decimal        @default(0) @map("paid_amount") @db.Decimal(15, 2)
  retentionPercent Decimal        @default(5) @map("retention_percent") @db.Decimal(5, 2)
  startDate        DateTime?      @map("start_date") @db.Date
  endDate          DateTime?      @map("end_date") @db.Date
  status           ContractStatus @default(DRAFT)
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @updatedAt @map("updated_at")

  project       Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  subcontractor Subcontractor          @relation(fields: [subcontractorId], references: [id], onDelete: Cascade)
  payments      SubcontractorPayment[]

  @@index([projectId])
  @@index([subcontractorId])
  @@map("subcontractor_contracts")
}

model SubcontractorPayment {
  id         String   @id @default(cuid())
  contractId String   @map("contract_id")
  amount     Decimal  @db.Decimal(15, 2)
  payDate    DateTime @map("pay_date") @db.Date
  reference  String?
  notes      String?
  createdAt  DateTime @default(now()) @map("created_at")

  contract SubcontractorContract @relation(fields: [contractId], references: [id], onDelete: Cascade)

  @@index([contractId])
  @@map("subcontractor_payments")
}
