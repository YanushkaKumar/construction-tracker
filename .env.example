# ============================================
# BuildTrack — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ── General ──────────────────────────────────
NODE_ENV=development
APP_NAME=BuildTrack
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=buildtrack
DB_PASSWORD=buildtrack_secret
DB_NAME=buildtrack
DATABASE_URL=postgresql://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:${DB_PORT}/${DB_NAME}?schema=public

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Authentication ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ── S3-Compatible Storage ────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=buildtrack-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── Email (SMTP / SendGrid) ─────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@buildtrack.lk
SMTP_FROM_NAME=BuildTrack

# ── WhatsApp (Twilio) ───────────────────────
WHATSAPP_ACCOUNT_SID=your-twilio-sid
WHATSAPP_AUTH_TOKEN=your-twilio-auth-token
WHATSAPP_FROM=whatsapp:+14155238886

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Frontend (Next.js Public) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=BuildTrack
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/buildtrack-storage

# ── Monitoring ───────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Rate Limiting ────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
