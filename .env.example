# ============================================
# BuildTrack — Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ── General ──────────────────────────────────
NODE_ENV=development
APP_NAME=BuildTrack
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# ── Database (PostgreSQL) ────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=buildtrack
DB_PASSWORD=buildtrack_secret
DB_NAME=buildtrack
# NOTE: values in a .env file are literal — Compose does NOT expand ${VARS}
# inside this file, so write the connection string out in full.
#
# Local / self-hosted Postgres container:
DATABASE_URL=postgresql://buildtrack:buildtrack_secret@postgres:5432/buildtrack?schema=public
#
# Supabase (use the *Session pooler* host — the direct db.<ref>.supabase.co
# host is IPv6-only on the free plan and unreachable from IPv4-only servers).
# Percent-encode special characters in the password (@ -> %40).
# connection_limit matters: Prisma otherwise opens (cores * 2 + 1) connections,
# which on a multi-core box exceeds the pooler's 15-connection ceiling.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&pool_timeout=20

# ── Redis ────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── JWT Authentication ───────────────────────
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production
JWT_REFRESH_EXPIRATION=7d

# ── S3-Compatible Storage ────────────────────
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=buildtrack-storage
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true

# ── Email (SMTP / SendGrid) ─────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
SMTP_FROM=noreply@buildtrack.lk
SMTP_FROM_NAME=BuildTrack

# ── WhatsApp (Twilio) ───────────────────────
WHATSAPP_ACCOUNT_SID=your-twilio-sid
WHATSAPP_AUTH_TOKEN=your-twilio-auth-token
WHATSAPP_FROM=whatsapp:+14155238886

# ── Telegram ─────────────────────────────────
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# ── Frontend (Next.js Public) ────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_NAME=BuildTrack
NEXT_PUBLIC_S3_PUBLIC_URL=http://localhost:9000/buildtrack-storage

# ── Monitoring ───────────────────────────────
PROMETHEUS_ENABLED=true
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# ── Rate Limiting ────────────────────────────
THROTTLE_TTL=60
THROTTLE_LIMIT=100
